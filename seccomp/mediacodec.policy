# device specific syscalls
# extension of services/mediacodec/minijail/seccomp_policy/mediacodec-seccomp-arm.policy
getpid: 1
gettid: 1
sendto: 1
pselect6: 1
eventfd2: 1
getsockopt: 1
sched_getparam: 1
sched_getscheduler: 1
mlock: 1
munlock: 1
recvfrom: 1
sched_setaffinity: 1
flock: 1
fchownat: 1
fchmodat: 1
fsync: 1
sysinfo: 1
#_llseek: 1
sysinfo: 1
# ffmpeg needs this
getdents64: 1
getcwd: 1
inotify_init1: 1
inotify_add_watch: 1
# Pie (16.0): extra syscalls the hermes lineage-16.0 tree (same SoC, MTK M
# blobs) allows on top of the base policy and that were missing here
sched_getaffinity: 1
setrlimit: 1
setsockopt: 1
tee: 1
