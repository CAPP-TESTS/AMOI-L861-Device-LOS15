# device specific syscalls
# extension of services/mediacodec/minijail/seccomp_policy/mediacodec-seccomp-arm.policy
getpid: 1
gettid: 1
sendto: 1
pselect6: 1
eventfd2: 1
getsockopt: 1
sched_getparam: 1
sched_getscheduler: 1
mlock: 1
munlock: 1
recvfrom: 1
sched_setaffinity: 1
flock: 1
fchownat: 1
fchmodat: 1
fsync: 1
sysinfo: 1
#_llseek: 1
sysinfo: 1
# ffmpeg needs this
getdents64: 1
getcwd: 1
inotify_init1: 1
inotify_add_watch: 1
# Pie (16.0): libc/ART call these on P; without them mediacodec gets
# killed by seccomp on first codec instantiation
getrandom: 1
sched_yield: 1
clock_getres: 1
