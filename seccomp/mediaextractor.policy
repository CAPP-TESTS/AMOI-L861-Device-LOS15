# MediaTek used system call
gettimeofday: 1
# for audio TableOfContent thread
ioprio_set: 1
unlinkat: 1
setsockopt: 1
clock_gettime: 1
# ffmpeg needs this
nanosleep: 1
readlinkat: 1
pread64: 1
mremap: 1
# Pie (16.0): extra syscall the hermes lineage-16.0 tree (same SoC, MTK M
# blobs) allows on top of the base policy and that was missing here
setrlimit: 1
